    <config>
      <usage>AAUDIO_USAGE_MEDIA</usage>
      <contentType>AAUDIO_CONTENT_TYPE_MUSIC</contentType>
      <performanceMode>AAUDIO_PERFORMANCE_MODE_POWER_SAVING</performanceMode>
      <sharingMode>AAUDIO_SHARING_MODE_SHARED</sharingMode>
      <audioFilePath>asset://sample/48k_2ch_16bit.wav</audioFilePath>
      <description>Media Playback (Power Saving Mode)</description>
    </config>
