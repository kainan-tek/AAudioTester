  <!--
    ===== Recording configurations (8 scenarios) =====
    Empty audioFilePath → auto-generated into the app's private directory (works on normal installs); /data/xx.wav uses a fixed path (requires system permissions).
  -->
  <recorder>
    <config>
      <inputPreset>AAUDIO_INPUT_PRESET_GENERIC</inputPreset>
      <sampleRate>48000</sampleRate>
      <channelCount>1</channelCount>
      <format>16</format>
      <performanceMode>AAUDIO_PERFORMANCE_MODE_LOW_LATENCY</performanceMode>
      <sharingMode>AAUDIO_SHARING_MODE_SHARED</sharingMode>
      <description>Generic Recording - 48kHz Mono 16-bit</description>
    </config>
    <config>
      <inputPreset>AAUDIO_INPUT_PRESET_CAMCORDER</inputPreset>
      <sampleRate>48000</sampleRate>
      <channelCount>2</channelCount>
